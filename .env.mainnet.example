# shellcheck disable=SC2034,SC2148
# ---------------------------------------------------------------------------
# Production environment (.env.mainnet)
# Copy to .env before running `bun run start:mainnet`.
# Target: Base mainnet (chainId 8453) + managed Postgres + registered Mini App domain.
# Every variable below is validated at config.mainnet.ts startup — boot fails fast if missing.
# ---------------------------------------------------------------------------

## CHAIN — Base mainnet
CHAIN_ID=8453
CHAIN_URI=https://mainnet.base.org
EVM_RPC_URL=https://mainnet.base.org
CHAIN_NAME=Base

## CONTRACT — set after `bunx hardhat ignition deploy --network base`
CANVAS_GAME_ADDRESS=

## EFFECTSTREAM NODE — block height at which CanvasGame was deployed
NODE_PORT=3333
START_BLOCKHEIGHT=

## DATABASE — managed Postgres (Supabase / Neon / RDS / etc.)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PW=

## BATCHER — hot wallet that pays gas for batched user inputs
BATCHER_PORT=3334
EVM_PRIVATE_KEY=

## FRONTEND (Mini App) — production domain registered in Warpcast
VITE_APP_URL=https://canvas.example.com
VITE_API_URL=https://api.canvas.example.com
VITE_BATCHER_URL=https://batcher.canvas.example.com
VITE_CHAIN_ID=8453
VITE_CHAIN_NAME=Base
# Hosted manifest URL returned by the Warpcast Mini App Manifest Tool
VITE_MANIFEST_URL=https://api.warpcast.com/miniapps/hosted-manifest/REPLACE_ME
