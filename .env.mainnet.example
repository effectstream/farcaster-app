# shellcheck disable=SC2034,SC2148
# ---------------------------------------------------------------------------
# Production environment (.env.mainnet)
# Copy to .env before running `bun run start:mainnet`.
# Target: Base mainnet (chainId 8453) + managed Postgres + registered Mini App domain.
# Every required var below is validated at config.mainnet.ts startup — boot fails
# fast if any of EVM_RPC_URL / CANVAS_GAME_ADDRESS / START_BLOCKHEIGHT / DB_* /
# EVM_PRIVATE_KEY is missing.
# ---------------------------------------------------------------------------

## CHAIN — Base mainnet
# Farcaster Mini App wallets default to Base mainnet (chainId 8453).
# Sepolia is *not* supported here — Warpcast's wallet will refuse to sign for it.
CHAIN_ID=8453
CHAIN_URI=https://mainnet.base.org
EVM_RPC_URL=https://mainnet.base.org
CHAIN_NAME=Base

## CONTRACT — set after `bun run --filter @farcaster-canvas/contracts-evm deploy:mainnet`
CANVAS_GAME_ADDRESS=0x3C4bF84da537ec08Fc9C326b8Ed04Cf695b76558

## EFFECTSTREAM NODE
# Block height at which CanvasGame was deployed (look up the deploy tx on basescan.org)
START_BLOCKHEIGHT=
EFFECTSTREAM_API_PORT=9999
# Optional RPC throttling for the EVM syncer. Defaults: stepSize=1000, delayMs=0.
# Lower stepSize / raise delayMs if you see 429s from your RPC provider.
# Typical safe values for free-tier public Base RPC: EVM_STEP_SIZE=500, EVM_DELAY_MS=200
# EVM_STEP_SIZE=1000
# EVM_DELAY_MS=0

## DATABASE — managed Postgres (Supabase / Neon / RDS / etc.)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PW=

## BATCHER — hot wallet that pays gas for batched user inputs
BATCHER_PORT=3334
EVM_PRIVATE_KEY=

## FRONTEND STATIC SERVER (only used when running `bun run start:mainnet` with the orchestrator)
FRONTEND_PORT=10599

## API CORS — explicit list of origins permitted to call /api/*.
# Set to your Mini App's production URL. Use comma-separated values for multiple
# (staging + prod), or "*" for any (not recommended).
CORS_ORIGIN=https://canvas.example.com

## FRONTEND (Mini App) — production domain registered with Warpcast
# These VITE_* values are baked into the SPA bundle by `bun run build:frontend`.
# Rebuild and redeploy the static site after changing any of them.
VITE_APP_URL=https://canvas.example.com
VITE_API_URL=https://api.canvas.example.com
VITE_BATCHER_URL=https://batcher.canvas.example.com
VITE_CHAIN_ID=8453
VITE_CHAIN_NAME=Base
VITE_CANVAS_GAME_ADDRESS=0x3C4bF84da537ec08Fc9C326b8Ed04Cf695b76558
# Hosted manifest URL returned by the Warpcast Mini App Manifest Tool.
# Use this to point /.well-known/farcaster.json at Warpcast's signed copy.
VITE_MANIFEST_URL=https://api.warpcast.com/miniapps/hosted-manifest/REPLACE_ME
