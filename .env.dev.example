# shellcheck disable=SC2034,SC2148
# ---------------------------------------------------------------------------
# Development environment (.env.dev)
# Copy to .env before running `bun run dev`:  cp .env.dev.example .env
# All values target a local stack: PGlite + Hardhat anvil + dev orchestrator.
# ---------------------------------------------------------------------------

## CHAIN — local Hardhat anvil
CHAIN_ID=31337
CHAIN_URI=http://localhost:8545
CHAIN_NAME=Hardhat

## EFFECTSTREAM NODE
EFFECTSTREAM_API_PORT=9999
START_BLOCKHEIGHT=0
# When PGLITE=true the node uses the in-process PGlite instance the orchestrator boots.
PGLITE=true
# Disable MQTT broker locally — events are still emitted, just not published.
MQTT_BROKER=false

## DATABASE (only used when PGLITE=false)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PW=postgres

## BATCHER
BATCHER_PORT=3334
# Hardhat account #0 — never use in production
EVM_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Optional separate batcher key (defaults to Hardhat #2 inside batcher.dev.ts)
# BATCHER_EVM_SECRET_KEY=

## API CORS — allow the Vite dev origin to reach /api routes
CORS_ORIGIN=http://localhost:5173

## FRONTEND (Mini App) — Vite reads any VITE_* var at build time
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:9999
VITE_BATCHER_URL=http://localhost:3334
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat
# Populated after `bun run build:evm` writes ignition/deployments/chain-31337/deployed_addresses.json
# Read it from that file (key: CanvasGameModule#CanvasGame) and paste it here.
VITE_CANVAS_GAME_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Optional: set when previewing through a tunnel (cloudflared / ngrok)
# VITE_PUBLIC_URL=https://your-tunnel.trycloudflare.com
